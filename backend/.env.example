# PawPotty Environment Configuration

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Groq API Configuration (Server-Side Only)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional Custom Posture Model Path
CUSTOM_POSTURE_MODEL_PATH=

# Optional Database Path (useful for Railway Persistent Volumes, e.g., /data/pawpotty.db)
DB_PATH=

# Server Port (Railway sets $PORT automatically)
PORT=8000
